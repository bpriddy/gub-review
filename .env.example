# Copy to .env.local for local development. .env.local is gitignored.
# This service is intentionally stateless — no DB, no secrets of its own.
# Only configuration it needs is the URL of the GUB backend it proxies to.

# ── GUB backend URL (server-side + client-side) ──────────────────────────────
# Used by /api/drive-review/[token] proxy routes to reach the GCP universal
# backend. In production, set via cloudbuild substitution to the deployed
# backend URL.
GUB_BACKEND_URL=http://localhost:3000
# Public fallback (used only if GUB_BACKEND_URL is unset).
NEXT_PUBLIC_GUB_URL=http://localhost:3000
